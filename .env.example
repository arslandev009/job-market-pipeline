# Copy this file to .env and fill in real values. .env itself is gitignored —
# never commit real credentials.

# --- Database ---
POSTGRES_USER=jmp_user
POSTGRES_PASSWORD=devpass
POSTGRES_DB=job_market
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jmp_user:devpass@localhost:5432/job_market

# --- LLM (llama.cpp server running natively on host) ---
LLM_BASE_URL=http://host.docker.internal:8080
LLM_TIMEOUT_SECONDS=30

# --- Google Sheets ---
# Path to your service account key file — see credentials.json.README
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials.json
GOOGLE_SHEET_NAME=Job Market Report
# Get this from the sheet's URL: .../spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=

# --- Scraper ---
SCRAPER_MAX_CONCURRENCY=3
SCRAPER_REQUEST_DELAY_SECONDS=1.5
SCRAPER_TIMEOUT_MS=15000
# 0 or unset = unlimited. Set to a small number (e.g. 25) for fast test runs.
SCRAPER_MAX_PER_SOURCE=25

# --- General ---
LOG_LEVEL=INFO
ENVIRONMENT=local
PROFILE_PATH=config/profile.yaml
